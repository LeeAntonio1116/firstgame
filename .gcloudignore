.env.*
.git/
.gitignore
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.log
scripts/
docs/
migrations/
*.md
.prettierrc
.prettierignore
requirements-dev.txt
pyproject.toml
.vscode/
.idea/
