# Supabase (REST API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# JWT 세션 토큰 서명용 (충분히 긴 무작위 문자열)
JWT_SECRET=change-me-to-a-long-random-string

# 회원가입 초대코드 (충분히 긴 무작위 문자열 — 미설정/빈값이면 가입 차단)
INVITE_CODE=change-me-to-a-long-random-string

# === P4-2 관리자 패널 ===
# 관리자 권한을 가질 사용자의 email 콤마 구분 목록 (단일 출처).
# 서버 부팅 시 users.email과 매치되는 행을 is_admin=TRUE로,
# 목록에 없는 모든 is_admin=TRUE 행은 FALSE로 동기화한다.
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# 자정 운영 로그 이메일 수신자 (1명)
ADMIN_EMAIL=ops@example.com

# === SMTP (Gmail 예시) ===
# Gmail 사용 시: Google 계정 → 보안 → 앱 비밀번호 발급(16자리, 공백 제거)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM_NAME=삼국지 길드 운영자

# 운영/개발 분기 (admin 세션 쿠키 Secure 플래그, IS_PROD 시 APScheduler 비활성 등)
ENV=development

# [S10 배포] Cloud Scheduler 공유 시크릿 (긴 무작위 문자열).
# Cloud Run에서 /internal/run-batch·/internal/maintenance 호출 인증용.
# 로컬은 비워둬도 됨 (/internal 미사용, APScheduler가 자정 작업 수행).
CRON_SECRET=change-me-to-a-long-random-string
